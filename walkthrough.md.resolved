      - onix_prod_net
    restart: always

  redis_prod:
    image: redis:7-alpine
    container_name: onix_redis_prod
    command: redis-server --maxmemory 2gb --maxmemory-policy allkeys-lru --save "" --appendonly no
    ports:
      - "6379:6379"
    volumes:
      - redis_prod_data:/data
    networks:
      - onix_prod_net
    restart: always
    deploy:
      resources:
        limits:
          memory: 2.5G

  qdrant_prod:
