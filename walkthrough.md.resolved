```diff:docker-compose.yml
services:
  # --- PRODUCTION STACK ---
  postgres_prod:
    image: postgres:16-alpine
    container_name: onix_postgres_prod
    environment:
      POSTGRES_USER: ${PROD_DB_USER:-onix_user}
      POSTGRES_PASSWORD: ${PROD_DB_PASS:-onix_pass}
      POSTGRES_DB: ${PROD_DB_NAME:-onix_db}
    ports:
      - "5432:5432"
    volumes:
      - postgres_prod_data:/var/lib/postgresql/data
