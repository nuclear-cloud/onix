// ================================================================
// КНИЖКОВИЙ КАТАЛОГ НА ОСНОВІ ONIX 3.0 — Prisma Schema
// Масштаб: 300k-1M книг, багато джерел цін, часті оновлення
// ================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "codelist"]
}

generator client {
  provider = "prisma-client-py"
  enable_experimental_decimal = true
  recursive_type_depth = -1
  previewFeatures = ["multiSchema"]
}

// ================================================================
// CORE: ПРОДУКТИ
// ================================================================

model CatalogProduct {
  id                      BigInt    @id @default(autoincrement())

  // ІДЕНТИФІКАТОРИ (ONIX ProductIdentifier)
  isbn13                  String?   @unique @db.VarChar(13)
  isbn10                  String?   @db.VarChar(10)
  gtin14                  String?   @db.VarChar(14)
  proprietary_id          String?   @db.VarChar(100) // власний ID

  // НАЗВА (ONIX TitleDetail)
  title                   String    @db.VarChar(500)
  subtitle                String?   @db.VarChar(500)

  // СЕРІЯ (ONIX Collection)
  collection_title        String?   @db.VarChar(300)
  collection_issn         String?   @db.VarChar(20)
  part_number             String?   @db.VarChar(50) // "Том 3", "Частина 2"

  // ФОРМА ПРОДУКТУ (ONIX ProductForm)
  product_form_code       String    @db.Char(2)
  product_form_detail_code String?  @db.VarChar(10)

  // ФІЗИЧНІ ХАРАКТЕРИСТИКИ (ONIX Measure, Extent)
  page_count              Int?
  width_mm                Decimal?  @db.Decimal(6, 2)
  height_mm               Decimal?  @db.Decimal(6, 2)
  thickness_mm            Decimal?  @db.Decimal(6, 2)
  weight_g                Decimal?  @db.Decimal(8, 2)

  // МОВА (ONIX Language)
  language_code           String    @default("ukr") @db.Char(3)

  // ВИДАВНИЦТВО (ONIX Publisher, Imprint)
  publisher_name          String?   @db.VarChar(300)
  publisher_id            String?   @db.VarChar(50)
  imprint_name            String?   @db.VarChar(300)

  // ПУБЛІКАЦІЯ (ONIX PublishingDetail)
  publishing_status_code  String    @db.Char(2)
  publication_date        DateTime? @db.Date
  out_of_print_date       DateTime? @db.Date

  // АУДИТОРІЯ (ONIX Audience)
  audience_code           String?   @db.Char(2)
  audience_range_qualifier String?  @db.VarChar(10)
  audience_range_from     Int?
  audience_range_to       Int?

  // КЛАСИФІКАЦІЯ
  primary_subject_scheme  String?   @db.VarChar(10)
  primary_subject_code    String?   @db.VarChar(50)

  // УКРАЇНСЬКИЙ КОНТЕКСТ
  udc_code                String?   @db.VarChar(50)
  bbk_code                String?   @db.VarChar(50)
  dk_018_code             String?   @db.VarChar(20)

  // EMBEDDING (для семантичного пошуку)
  embedding               Unsupported("vector(1536)")?

  // МЕТАДАТА
  metadata                Json?

  // СЛУЖБОВІ
  created_at              DateTime  @default(now()) @db.Timestamptz(6)
  updated_at              DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at              DateTime? @db.Timestamptz(6)
  is_active               Boolean   @default(true)

  // RELATIONS
  contributors            ProductContributor[]
  subjects                ProductSubject[]
  text_content            TextContent[]
  media_files             MediaFile[]
  prices                  Price[]
  sales_rights            SalesRight[]
  related_products_from   RelatedProduct[] @relation("ProductFrom")
  related_products_to     RelatedProduct[] @relation("ProductTo")

  @@index([isbn13])
  @@index([publishing_status_code])
  @@index([publisher_name])
  @@index([product_form_code])
  @@index([language_code])
  @@index([publication_date])
  @@index([deleted_at])
  @@map("catalog_products")
  @@schema("public")
}

// ================================================================
// CONTRIBUTORS: АВТОРИ, ПЕРЕКЛАДАЧІ, ІЛЮСТРАТОРИ (N:N)
// ================================================================

// Unique persons/organizations
model Contributor {
  id                      BigInt    @id @default(autoincrement())

  // ІМ'Я (ONIX PersonName, CorporateName)
  contributor_type        String    @db.Char(1) // P=Person, C=Corporate
  person_name             String?   @db.VarChar(300)
  person_name_inverted    String?   @db.VarChar(300)
  key_names               String?   @db.VarChar(200)
  names_before_key        String?   @db.VarChar(200)
  corporate_name          String?   @db.VarChar(300)

  // ДОДАТКОВО
  biographical_note       String?
  
  // External IDs (for deduplication)
  yakaboo_option_id       String?   @db.VarChar(50)

  created_at              DateTime  @default(now()) @db.Timestamptz(6)
  updated_at              DateTime  @updatedAt @db.Timestamptz(6)

  // N:N relation
  products                ProductContributor[]

  @@unique([contributor_type, person_name])
  @@unique([contributor_type, corporate_name])
  @@index([person_name])
  @@index([corporate_name])
  @@schema("public")
}

// Junction table for N:N relationship
model ProductContributor {
  id                      BigInt    @id @default(autoincrement())
  
  product_id              BigInt
  product                 CatalogProduct @relation(fields: [product_id], references: [id], onDelete: Cascade)
  
  contributor_id          BigInt
  contributor             Contributor @relation(fields: [contributor_id], references: [id], onDelete: Cascade)

  // Role in THIS book (same person can be author in one, translator in another)
  role_code               String    @db.VarChar(3) // A01=Author, B06=Translator, etc
  sequence_number         Int?

  created_at              DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([product_id, contributor_id, role_code])
  @@index([product_id])
  @@index([contributor_id])
  @@index([role_code])
  @@schema("public")
}

// ================================================================
// SUBJECTS: ВСІ КАТЕГОРІЇ, ТЕМИ, КЛЮЧОВІ СЛОВА (N:N)
// ================================================================

// Unique subjects (keywords, categories, THEMA codes)
model Subject {
  id                      BigInt    @id @default(autoincrement())

  // ONIX Subject scheme identifier
  scheme_code             String    @db.VarChar(10) // 20=Keywords, 24=Proprietary, 93=Thema
  subject_code            String?   @db.VarChar(100)
  subject_heading_text    String    @db.VarChar(500)

  created_at              DateTime  @default(now()) @db.Timestamptz(6)

  // N:N relation
  products                ProductSubject[]

  @@unique([scheme_code, subject_code, subject_heading_text])
  @@index([scheme_code])
  @@index([subject_code])
  @@index([subject_heading_text])
  @@schema("public")
}

// Junction table for N:N relationship
model ProductSubject {
  id                      BigInt    @id @default(autoincrement())

  product_id              BigInt
  product                 CatalogProduct @relation(fields: [product_id], references: [id], onDelete: Cascade)

  subject_id              BigInt
  subject                 Subject @relation(fields: [subject_id], references: [id], onDelete: Cascade)

  // Priority in THIS book
  is_primary              Boolean   @default(false)
  sequence_number         Int?

  created_at              DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([product_id, subject_id])
  @@index([product_id])
  @@index([subject_id])
  @@schema("public")
}

// ================================================================
// TEXT_CONTENT: ОПИСИ, АНОТАЦІЇ, УРИВКИ
// ================================================================

model TextContent {
  id                      BigInt    @id @default(autoincrement())
  product_id              BigInt
  product                 CatalogProduct @relation(fields: [product_id], references: [id], onDelete: Cascade)

  // ONIX TextType codes
  text_type_code          String    @db.Char(2) // 01-99
  content                 String
  author                  String?   @db.VarChar(200)
  source_title            String?   @db.VarChar(300)

  created_at              DateTime  @default(now()) @db.Timestamptz(6)

  @@index([product_id])
  @@index([text_type_code])
  @@schema("public")
}

// ================================================================
// MEDIA: ОБКЛАДИНКИ, ВІДЕО, АУДІО
// ================================================================

model MediaFile {
  id                      BigInt    @id @default(autoincrement())
  product_id              BigInt
  product                 CatalogProduct @relation(fields: [product_id], references: [id], onDelete: Cascade)

  // ONIX SupportingResource
  resource_content_type_code String  @db.Char(2) // 01-18
  resource_mode_code      String    @db.Char(2) // 03=Image, 06=Video, 07=Audio

  // ФАЙЛ
  file_format_code        String?   @db.Char(2)
  file_link_type          String?   @db.Char(2)
  file_link               String
  width_px                Int?
  height_px               Int?
  file_size_bytes         BigInt?

  sequence_number         Int?
  created_at              DateTime  @default(now()) @db.Timestamptz(6)

  @@index([product_id])
  @@index([resource_content_type_code])
  @@schema("public")
}

// ================================================================
// PRICE_SOURCES: ДЖЕРЕЛА ЦІН
// ================================================================

model PriceSource {
  id                      Int       @id @default(autoincrement())
  source_code             String    @unique @db.VarChar(50)
  source_name             String    @db.VarChar(200)
  source_type             String    @db.VarChar(20) // retailer, wholesaler, internal
  api_endpoint            String?   @db.VarChar(500)
  is_active               Boolean   @default(true)

  created_at              DateTime  @default(now()) @db.Timestamptz(6)

  prices                  Price[]

  @@index([is_active])
  @@schema("public")
}

// ================================================================
// PRICES: ЦІНИ З ІСТОРІЄЮ
// ================================================================

model Price {
  id                      BigInt    @id @default(autoincrement())
  product_id              BigInt
  product                 CatalogProduct @relation(fields: [product_id], references: [id], onDelete: Cascade)
  source_id               Int
  source                  PriceSource @relation(fields: [source_id], references: [id])

  // ONIX Price fields
  price_type_code         String    @db.Char(2) // 01=RRP, 02=Agency, 03=Wholesale, 41=Promo
  price_amount            Decimal   @db.Decimal(12, 2)
  currency_code           String    @default("UAH") @db.Char(3)

  // ПОДАТКИ
  tax_type_code           String?   @db.Char(2)
  tax_rate_percent        Decimal?  @db.Decimal(5, 2)
  tax_amount              Decimal?  @db.Decimal(12, 2)

  // ВАЛІДНІСТЬ
  price_effective_from    DateTime? @db.Date
  price_effective_until   DateTime? @db.Date

  // ЗНИЖКИ
  discount_percent        Decimal?  @db.Decimal(5, 2)

  // НАЯВНІСТЬ
  stock_quantity          Int?

  recorded_at             DateTime  @default(now()) @db.Timestamptz(6)

  @@index([product_id, recorded_at(sort: Desc)])
  @@index([source_id, recorded_at(sort: Desc)])
  @@schema("public")
}

// ================================================================
// CURRENT_PRICES: МАТЕРІАЛІЗОВАНЕ VIEW
// (генеруємо через SQL migration)
// ================================================================

// Prisma doesn't support materialized views natively,
// so we define this as a model but mark it as read-only via comments
// In app code: use @db.Raw() for queries or create a separate view query

// ================================================================
// SALES_RIGHTS: ПРАВА ПРОДАЖУ ПО ТЕРИТОРІЯХ
// ================================================================

model SalesRight {
  id                      BigInt    @id @default(autoincrement())
  product_id              BigInt
  product                 CatalogProduct @relation(fields: [product_id], references: [id], onDelete: Cascade)

  sales_rights_type_code  String    @db.Char(2)
  territory_countries     String[]  @db.VarChar(10) // ['UA', 'PL', 'DE']
  territory_regions       String[]  @db.VarChar(10)

  start_date              DateTime? @db.Date
  end_date                DateTime? @db.Date

  @@index([product_id])
  @@schema("public")
}

// ================================================================
// RELATED_PRODUCTS: ПОВ'ЯЗАНІ ТОВАРИ
// ================================================================

model RelatedProduct {
  id                      BigInt    @id @default(autoincrement())
  product_id              BigInt
  product                 CatalogProduct @relation("ProductFrom", fields: [product_id], references: [id], onDelete: Cascade)
  related_product_id      BigInt
  related_product         CatalogProduct @relation("ProductTo", fields: [related_product_id], references: [id], onDelete: Cascade)

  relation_code           String    @db.Char(2)

  @@unique([product_id, related_product_id])
  @@index([product_id])
  @@index([related_product_id])
  @@schema("public")
}

// ================================================================
// ONIX_CODE_LISTS: ДОВІДНИКИ КОДІВ (schema: codelist)
// ================================================================

model CodeListProductForm {
  code                    String    @id @db.Char(2)
  description             String    @db.VarChar(200)
  category                String?   @db.VarChar(50)

  @@map("product_form")
  @@schema("codelist")
}

model CodeListPublishingStatus {
  code                    String    @id @db.Char(2)
  description             String    @db.VarChar(200)

  @@map("publishing_status")
  @@schema("codelist")
}

model CodeListContributorRole {
  code                    String    @id @db.VarChar(3)
  description             String    @db.VarChar(200)
  category                String?   @db.VarChar(50)

  @@map("contributor_role")
  @@schema("codelist")
}

model CodeListPriceType {
  code                    String    @id @db.Char(2)
  description             String    @db.VarChar(200)

  @@map("price_type")
  @@schema("codelist")
}

model CodeListTextType {
  code                    String    @id @db.Char(2)
  description             String    @db.VarChar(200)

  @@map("text_type")
  @@schema("codelist")
}

model CodeListAudience {
  code                    String    @id @db.Char(2)
  description             String    @db.VarChar(200)

  @@map("audience")
  @@schema("codelist")
}

model CodeListSubjectScheme {
  code                    String    @id @db.VarChar(10)
  description             String    @db.VarChar(200)
  url                     String?   @db.VarChar(500)

  @@map("subject_scheme")
  @@schema("codelist")
}

// ================================================================
// AUDIT: ЛОГУВАННЯ ЗМІН
// ================================================================

model AuditLog {
  id                      BigInt    @id @default(autoincrement())
  table_name              String    @db.VarChar(50)
  record_id               BigInt
  operation               String    @db.VarChar(10) // INSERT, UPDATE, DELETE
  old_data                Json?
  new_data                Json?
  changed_by              String?   @db.VarChar(100)
  changed_at              DateTime  @default(now()) @db.Timestamptz(6)

  @@index([table_name, record_id])
  @@index([changed_at])
  @@schema("public")
}
