generator client {
  provider                    = "prisma-client-py"
  recursive_type_depth        = "5"
  interface                   = "asyncio"
  enable_experimental_decimal = true
}

datasource db {
  provider = "postgresql"
  url      = env("PRISMA_DATABASE_URL")
}

model CatalogProduct {
  id                                String                              @id @default(uuid()) @db.Uuid
  recordReference                   String                              @unique(map: "ix_catalog_products_record_reference") @map("record_reference") @db.VarChar(100)
  notificationType                  list1?                              @map("notification_type")
  isbn13                            String?                             @unique(map: "ix_catalog_products_isbn_13") @map("isbn_13") @db.VarChar(13)
  ean                               String?                             @unique @db.VarChar(13)
  sku                               String?                             @map("sku") @db.VarChar(50)
  productForm                       list150                             @map("product_form")
  productFormDetail                 list175?                            @map("product_form_detail")
  editionNumber                     Int?                                @map("edition_number")
  publishingStatus                  list64?                             @map("publishing_status")
  isUkrainian                       Boolean?                            @map("is_ukrainian")
  onixFull                          Json?                               @map("onix_full")
  createdAt                         DateTime?                           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                         DateTime?                           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  publisherId                       String?                             @map("publisher_id") @db.Uuid
  audienceRanges                    CatalogAudienceRange[]
  citedContents                     CatalogCitedContent[]
  extents                           CatalogExtent[]
  languages                         CatalogLanguage[]
  measures                          CatalogMeasure[]
  prizes                            CatalogPrize[]
  catalog_product_collections_link  catalog_product_collections_link[]
  catalog_product_contributors_link catalog_product_contributors_link[]
  publisher                         Publisher?                          @relation(fields: [publisherId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  publishingDates                   CatalogPublishingDate[]
  relatedProducts                   CatalogRelatedProduct[]
  subjects                          CatalogSubject[]
  textContents                      CatalogTextContent[]
  titles                            CatalogTitle[]
  offers                            offers[]

  @@index([isUkrainian], map: "ix_catalog_products_is_ukrainian")
  @@index([productForm], map: "ix_catalog_products_product_form")
  @@index([sku], map: "ix_catalog_products_sku")
  @@map("catalog_products")
}

model Publisher {
  id       String           @id @default(uuid()) @db.Uuid
  name     String           @unique @db.VarChar(255)
  gln      String?          @db.VarChar(13)
  products CatalogProduct[]

  @@map("catalog_publishers")
}

model Contributor {
  id                                String                              @id @default(uuid()) @db.Uuid
  name                              String                              @db.VarChar(255)
  person_name_inverted              String?                             @db.VarChar(255)
  biographical_note                 String?
  catalog_product_contributors_link catalog_product_contributors_link[]

  @@index([name], map: "ix_catalog_contributors_name")
  @@map("catalog_contributors")
}

model CatalogTitle {
  id        String         @id @default(uuid()) @db.Uuid
  productId String         @map("product_id") @db.Uuid
  type      list15
  titleText String         @map("title_text")
  subtitle  String?
  product   CatalogProduct @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("catalog_titles")
}

model CatalogProductContributor {
  id                   String          @id @default(uuid()) @db.Uuid
  productId            String          @map("product_id") @db.Uuid
  person_name          String?         @db.VarChar(255)
  person_name_inverted String?         @db.VarChar(255)
  corporate_name       String?         @db.VarChar(255)
  biographical_note    String?
  role                 contributorrole
  sequenceNumber       Int?            @map("sequence_number")

  @@map("catalog_product_contributors")
}

model CatalogMeasure {
  id          String         @id @default(uuid()) @db.Uuid
  productId   String         @map("product_id") @db.Uuid
  type        list48
  measurement Decimal        @db.Decimal(10, 2)
  unit_code   list50
  product     CatalogProduct @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("catalog_measures")
}

model CatalogExtent {
  id        String         @id @default(uuid()) @db.Uuid
  productId String         @map("product_id") @db.Uuid
  type      list23
  value     Decimal        @db.Decimal(10, 2)
  unit      String?        @db.VarChar(10)
  product   CatalogProduct @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("catalog_extents")
}

model CatalogSubject {
  id                   String         @id @default(uuid()) @db.Uuid
  productId            String         @map("product_id") @db.Uuid
  scheme_identifier    list27
  subjectCode          String?        @map("subject_code") @db.VarChar(100)
  subject_heading_text String?        @db.VarChar(500)
  product              CatalogProduct @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("catalog_subjects")
}

model CatalogAudienceRange {
  id        String         @id @default(uuid()) @db.Uuid
  productId String         @map("product_id") @db.Uuid
  qualifier list30?
  precision list31?
  value     String         @db.VarChar(10)
  product   CatalogProduct @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("catalog_audience_ranges")
}

model CatalogLanguage {
  id        String         @id @default(uuid()) @db.Uuid
  productId String         @map("product_id") @db.Uuid
  role      list22?
  code      String         @db.VarChar(3)
  product   CatalogProduct @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("catalog_languages")
}

model CatalogPrize {
  id        String         @id @default(uuid()) @db.Uuid
  productId String         @map("product_id") @db.Uuid
  name      String         @db.VarChar(255)
  year      String?        @db.VarChar(4)
  country   list49?
  code      String?        @db.VarChar(2)
  product   CatalogProduct @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("catalog_prizes")
}

model CatalogTextContent {
  id        String         @id @default(uuid()) @db.Uuid
  productId String         @map("product_id") @db.Uuid
  type      list153
  text      String
  author    String?        @db.VarChar(255)
  product   CatalogProduct @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("catalog_text_contents")
}

model CatalogCitedContent {
  id            String         @id @default(uuid()) @db.Uuid
  productId     String         @map("product_id") @db.Uuid
  type          String         @db.VarChar(2)
  sourceTitle   String?        @map("source_title") @db.VarChar(255)
  citation_note String?
  link          String?        @db.VarChar(500)
  product       CatalogProduct @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("catalog_cited_contents")
}

model CatalogRelatedProduct {
  id                       String         @id @default(uuid()) @db.Uuid
  productId                String         @map("product_id") @db.Uuid
  relation_code            list51
  related_product_id_type  String?        @db.VarChar(2)
  related_product_id_value String         @db.VarChar(255)
  product                  CatalogProduct @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("catalog_related_products")
}

model CatalogPublishingDate {
  id          String         @id @default(uuid()) @db.Uuid
  productId   String         @map("product_id") @db.Uuid
  role        list163
  date_value  String         @db.VarChar(8)
  date_format String?        @db.VarChar(2)
  product     CatalogProduct @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("catalog_publishing_dates")
}

model authors {
  id              String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  full_name       String            @db.VarChar(255)
  biography       String?
  product_authors product_authors[]
}

model catalog_collections {
  id                               String                             @id @db.Uuid
  title                            String                             @db.VarChar(1000)
  type                             list148?
  issn                             String?                            @db.VarChar(8)
  catalog_product_collections_link catalog_product_collections_link[]

  @@index([title], map: "ix_catalog_collections_title")
}

model catalog_prices {
  id           String     @id @db.Uuid
  product_id   String     @db.Uuid
  price_type   pricetype?
  price_amount Decimal    @db.Decimal(10, 2)
  currency     String?    @db.VarChar(3)
}

model catalog_product_collections_link {
  product_id          String                  @db.Uuid
  collection_id       String                  @db.Uuid
  sequence_type       collectionsequencetype?
  sequence_number     String?                 @db.VarChar(50)
  catalog_collections catalog_collections     @relation(fields: [collection_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  catalog_products    CatalogProduct          @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([product_id, collection_id])
}

model catalog_product_contributors_link {
  product_id           String         @db.Uuid
  contributor_id       String         @db.Uuid
  role                 list17
  sequence_number      Int?
  catalog_contributors Contributor    @relation(fields: [contributor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  catalog_products     CatalogProduct @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([product_id, contributor_id, role])
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model codelist_values {
  id          Int        @id @default(autoincrement())
  list_number Int?
  code_value  String     @db.VarChar(50)
  description String
  notes       String?
  is_active   Boolean?   @default(true)
  created_at  DateTime?  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime?  @default(now()) @db.Timestamptz(6)
  codelists   codelists? @relation(fields: [list_number], references: [list_number], onDelete: Cascade, onUpdate: NoAction)

  @@unique([list_number, code_value], map: "idx_codelist_value_unique")
}

model codelists {
  list_number     Int               @id
  list_name       String            @db.VarChar(255)
  issue_number    Int?
  is_active       Boolean?          @default(true)
  created_at      DateTime?         @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?         @default(now()) @db.Timestamptz(6)
  codelist_values codelist_values[]
}

model collections {
  id       String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title    String     @db.VarChar(255)
  issn     String?    @db.VarChar(9)
  products products[]
}

model offers {
  id               String          @id @db.Uuid
  book_id          String          @db.Uuid
  supplier_id      String          @db.Uuid
  sku              String?         @db.VarChar(100)
  url              String?
  price            Decimal         @db.Decimal(10, 2)
  price_old        Decimal?        @db.Decimal(10, 2)
  currency         String?         @db.VarChar(3)
  availability     list65?
  in_stock         Boolean?
  last_updated     DateTime?       @default(now()) @db.Timestamptz(6)
  catalog_products CatalogProduct  @relation(fields: [book_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  suppliers        suppliers       @relation(fields: [supplier_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  price_history    price_history[]

  @@unique([book_id, supplier_id], map: "uq_offer_book_supplier")
  @@index([book_id], map: "ix_offers_book_id")
  @@index([last_updated], map: "ix_offers_last_updated")
}

/// This table is a partition table and requires additional setup for migrations. Visit https://pris.ly/d/partition-tables for more info.
model price_history {
  id           String   @db.Uuid
  offer_id     String   @db.Uuid
  price        Decimal  @db.Decimal(10, 2)
  currency     String?  @db.VarChar(3)
  availability list65?
  recorded_at  DateTime @default(now()) @db.Timestamptz(6)
  offers       offers   @relation(fields: [offer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([id, recorded_at])
  @@index([offer_id], map: "ix_price_history_offer_id")
  @@index([recorded_at], map: "ix_price_history_recorded_at")
}

model product_authors {
  product_id      String   @db.Uuid
  author_id       String   @db.Uuid
  role_code       String?  @default("A01") @db.VarChar(10)
  sequence_number Int?     @default(1)
  authors         authors  @relation(fields: [author_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products        products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([product_id, author_id])
}

model product_links {
  id              Int        @id @default(autoincrement())
  product_isbn    String?    @db.VarChar
  url             String     @unique(map: "ix_product_links_url") @db.VarChar
  domain          String     @db.VarChar
  last_checked_at DateTime?  @db.Timestamp(6)
  status          linkstatus @default(discovered)
  depth           Int        @default(0)
  created_at      DateTime   @default(now()) @db.Timestamp(6)
  error_message   String?    @db.VarChar
  updated_at      DateTime?  @db.Timestamp(6)
  products        products?  @relation(fields: [product_isbn], references: [isbn_13], onDelete: Cascade, onUpdate: NoAction)

  @@index([domain], map: "ix_product_links_domain")
  @@index([domain, product_isbn], map: "ix_product_links_domain_isbn")
  @@index([domain, status], map: "ix_product_links_domain_status")
  @@index([product_isbn], map: "ix_product_links_product_isbn")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model product_sources {
  id         Int       @id @default(autoincrement())
  isbn13     String?   @db.VarChar
  domain     String    @db.VarChar
  raw_data   Json      @db.Json
  updated_at DateTime  @db.Timestamp(6)
  products   products? @relation(fields: [isbn13], references: [isbn_13], onDelete: Cascade, onUpdate: NoAction)

  @@unique([isbn13, domain], map: "uq_product_source_isbn_domain")
  @@index([domain], map: "ix_product_sources_domain")
  @@index([isbn13], map: "ix_product_sources_isbn13")
}

model products {
  id              String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  isbn_13         String                 @unique @db.Char(13)
  title           String                 @db.VarChar(500)
  publisher_id    String?                @db.Uuid
  collection_id   String?                @db.Uuid
  product_form    String?                @db.VarChar(10)
  language        String?                @default("ukr") @db.Char(3)
  onix_json       Json?
  embedding       Unsupported("vector")?
  created_at      DateTime?              @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?              @default(now()) @db.Timestamptz(6)
  product_authors product_authors[]
  product_links   product_links[]
  product_sources product_sources[]
  collections     collections?           @relation(fields: [collection_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  publishers      publishers?            @relation(fields: [publisher_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([embedding], map: "idx_products_embedding")
  @@index([isbn_13], map: "idx_products_isbn")
  @@index([onix_json], map: "idx_products_onix_json", type: Gin)
}

model publishers {
  id       String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name     String     @db.VarChar(255)
  gln      String?    @db.VarChar(13)
  products products[]
}

model ref_onix_codelists {
  list_number       Int
  code              String  @db.VarChar(50)
  description       String?
  notes             String?
  issue_number      String? @db.VarChar(10)
  modified_number   String? @db.VarChar(10)
  deprecated_number String? @db.VarChar(10)
  is_active         Boolean @default(true)

  @@id([list_number, code])
  @@index([list_number], map: "ix_ref_onix_codelists_list_number")
}

model ref_thema_subjects {
  code                     String               @id @db.VarChar(20)
  parent_code              String?              @db.VarChar(20)
  label_en                 String               @db.VarChar(255)
  label_uk                 String?              @db.VarChar(255)
  description_en           String?
  description_uk           String?
  is_active                Boolean              @default(true)
  ref_thema_subjects       ref_thema_subjects?  @relation("ref_thema_subjectsToref_thema_subjects", fields: [parent_code], references: [code], onDelete: NoAction, onUpdate: NoAction)
  other_ref_thema_subjects ref_thema_subjects[] @relation("ref_thema_subjectsToref_thema_subjects")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model scraper_configs {
  domain                 String    @id @db.VarChar
  selectors              Json      @db.Json
  strategy               String    @db.VarChar
  is_dirty               Boolean
  is_active              Boolean
  is_crawling_active     Boolean   @default(false)
  max_crawl_depth        Int       @default(3)
  crawl_delay_seconds    Int       @default(2)
  sitemap_urls           Json?     @default("[]")
  allow_patterns         Json?     @default("[]")
  deny_patterns          Json?     @default("[]")
  crawl_interval_seconds Int       @default(86400)
  last_crawled_at        DateTime? @db.Timestamp(6)
  locked_by              String?   @db.VarChar
  locked_at              DateTime? @db.Timestamp(6)
  lock_expires_at        DateTime? @db.Timestamp(6)
  next_run_at            DateTime? @db.Timestamp(6)
  last_cycle_partial     Boolean?  @default(false)
  last_stop_reason       String?   @db.VarChar
  last_cycle_stats       Json?
  max_pages_per_cycle    Int?      @default(5000)

  @@index([is_active, locked_by, last_crawled_at], map: "idx_scraper_configs_lock_status")
}

model suppliers {
  id        String   @id @db.Uuid
  name      String   @unique @db.VarChar(255)
  code      String   @unique @db.VarChar(50)
  base_url  String?  @db.VarChar(500)
  is_active Boolean?
  offers    offers[]
}

