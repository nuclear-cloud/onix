{
  // --- АДМІНІСТРАТИВНА ЧАСТИНА ---
  "RecordReference": "978-966-1234-56-7", // Унікальний ID запису (ISBN або внутрішній SKU)
  
  // 03 = Notification confirmed (Запис підтверджено, книга видана)
  "NotificationType": "03", 

  // --- ІДЕНТИФІКАТОРИ ---
  "ProductIdentifier": [
    {
      "ProductIDType": "15", // 15 = ISBN-13
      "IDValue": "9789661234567"
    },
    {
      "ProductIDType": "01", // 01 = Внутрішній ID (Proprietary)
      "IDValue": "SKU-12345-UA"
    }
  ],

  // --- ОПИС ПРОДУКТУ ---
  // BB = Hardback (Тверда обкладинка). 
  // Деталізація: B102 = Trade Hardback (Стандартний формат)
  "ProductForm": "BB", 
  "ProductFormDetail": ["B102"], 

  // --- РОЗМІРИ ТА ВАГА (Measure) ---
  "Measure": [
    {
      "MeasureType": "01", // 01 = Height (Висота)
      "Measurement": 240,
      "MeasureUnitCode": "mm"
    },
    {
      "MeasureType": "02", // 02 = Width (Ширина)
      "Measurement": 170,
      "MeasureUnitCode": "mm"
    },
    {
      "MeasureType": "03", // 03 = Thickness (Товщина)
      "Measurement": 25,
      "MeasureUnitCode": "mm"
    },
    {
      "MeasureType": "08", // 08 = Weight (Вага)
      "Measurement": 450,
      "MeasureUnitCode": "gr"
    }
  ],

  // --- ОБСЯГ (Extent) ---
  "Extent": [
    {
      "ExtentType": "00", // 00 = Main Content Page Count (Кількість сторінок)
      "ExtentValue": 320,
      "ExtentUnit": "03" // 03 = Pages
    },
    {
      "ExtentType": "09", // 09 = Duration (Тривалість - для аудіокниг)
      "ExtentValue": 0, // Тут 0, бо це паперова книга
      "ExtentUnit": "16" // 16 = Hours
    }
  ],

  "TitleDetail": [
    {
      "TitleType": "01", // 01 = Distinctive Title (Основна назва на обкладинці)
      "TitleElement": [
        {
          "TitleElementLevel": "01", // 01 = Product Level (Назва всього продукту)
          "TitleText": "Тіні забутих предків. Графічний роман",
          "Subtitle": "Спеціальне ілюстроване видання"
        }
      ]
    },
    {
      "TitleType": "03", // 03 = Original Title (Оригінальна назва, якщо це переклад)
      "TitleElement": [
        { "TitleElementLevel": "01", "TitleText": "Тіні забутих предків" }
      ]
    }
  ],

  // --- АВТОРИ ---
  "Contributor": [
    {
      "SequenceNumber": 1, // Порядок відображення (1-й автор)
      "ContributorRole": ["A01"], // A01 = Author (Автор тексту)
      "PersonName": "Михайло Коцюбинський",
      "PersonNameInverted": "Коцюбинський, Михайло",
      "BiographicalNote": "Класик української літератури..."
    },
    {
      "SequenceNumber": 2,
      "ContributorRole": ["A12"], // A12 = Illustrator (Ілюстратор)
      "PersonName": "Іван Ілюстратор"
    }
  ],

  // --- МОВА ---
  "Language": [
    {
      "LanguageRole": "01", // 01 = Language of Text (Мова тексту книги)
      "LanguageCode": "ukr" // ISO код: ukr, eng, fra
    }
  ],

  // --- ТЕМИ / ЖАНРИ ---
  "Subject": [
    {
      "SubjectSchemeIdentifier": "93", // 93 = Thema (Міжнародний стандарт категорій)
      "SubjectCode": "FBA", // FBA = Modern & contemporary fiction (Сучасна художня література)
      "SubjectHeadingText": "Modern & contemporary fiction"
    },
    {
      "SubjectSchemeIdentifier": "20", // 20 = Keywords (Ключові слова)
      "SubjectHeadingText": "Гуцульщина; Карпати; Містика"
    }
  ],

  // --- АУДИТОРІЯ ---
  "AudienceRange": [
    {
      "AudienceRangeQualifier": "11", // 11 = Age (Вік)
      "AudienceRangePrecision1": "03", // 03 = From (Від)
      "AudienceRangeValue1": "16" // 16 років
    }
  ],

  // --- СЕРІЯ (Collection) ---
  "Collection": [
    {
      "CollectionType": "10", // 10 = Publisher Collection (Серія видавництва)
      "CollectionIdentifier": [
        { "CollectionIDType": "15", "IDValue": "9789661230001" } // ISSN або ISBN серії
      ],
      "TitleDetail": [
        {
          "TitleType": "01",
          "TitleElement": [
            { "TitleElementLevel": "02", "TitleText": "Українська класика в коміксах" }
          ]
        }
      ],
      "CollectionSequence": [
        {
          "CollectionSequenceType": "02", // 02 = Order in series (Номер у серії)
          "CollectionSequenceNumber": "5"
        }
      ]
    }
  ],

  // --- НАГОРОДИ (Prize) ---
  "Prize": [
    {
      "PrizeName": "Книга року BBC",
      "PrizeYear": "2024",
      "PrizeCountry": "UA",
      "PrizeCode": "02" // 02 = Winner (Переможець)
    }
  ],

  // --- РЕЦЕНЗІЇ ТА ВІДГУКИ (CollateralDetail) ---
  "CollateralDetail": {
    "TextContent": [
      {
        "TextType": "03", // Анотація
        "ContentAudience": "00",
        "Text": "Графічна адаптація відомої повісті..."
      }
    ],
    "CitedContent": [
      {
        "CitedContentType": "06", // 06 = Review Quote (Цитата з рецензії)
        "ContentAudience": "00",
        "SourceTitle": "The New York Times",
        "CitationNote": "A masterpiece of visual storytelling.",
        "ResourceVersion": [ { "ResourceLink": "https://nytimes.com/review/..." } ]
      },
      {
        "CitedContentType": "08", // 08 = Review Full Text (Повний відгук)
        "SourceTitle": "ЛітАкцент",
        "CitationNote": "Найкраще переосмислення класики за останні роки."
      }
    ],
    "SupportingResource": [
       // ... (Обкладинки)
    ]
  },
  

  // --- ВИДАВНИЦТВО ---
  "Publisher": [
    {
      "PublishingRole": "01", // 01 = Publisher (Видавець)
      "PublisherName": "А-БА-БА-ГА-ЛА-МА-ГА"
    }
  ],

  "PublishingDate": [
    {
      "PublishingDateRole": "01", // 01 = Publication Date (Дата виходу)
      "Date": "20240901", // YYYYMMDD
      "DateFormat": "00"
    }
  ],

  // --- ЗВ'ЯЗАНІ ТОВАРИ ---
  "RelatedProduct": [
    {
      "ProductRelationCode": "06", // 06 = Alternative Format (Інший формат тієї ж книги)
